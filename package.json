{
  "name": "commit-story",
  "version": "2.0.0-alpha.0",
  "description": "Automated engineering journal powered by LangGraph - captures git commits and AI assistant conversations",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "commit-story": "src/index.js",
    "commit-story-mcp": "src/mcp/server.js",
    "commit-story-init": "scripts/install-hook.sh",
    "commit-story-remove": "scripts/uninstall-hook.sh"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "git",
    "journal",
    "ai",
    "langgraph",
    "opentelemetry"
  ],
  "author": "Whitney Lee",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wiggitywhitney/commit-story-v2.git"
  },
  "files": [
    "src/",
    "scripts/install-hook.sh",
    "scripts/uninstall-hook.sh"
  ],
  "engines": {
    "node": "^18.19.0 || >=20.6.0"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.3.10",
    "@langchain/core": "^1.1.15",
    "@langchain/langgraph": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@opentelemetry/instrumentation-pino": "^0.65.0",
    "dotenv": "^17.0.0",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "overrides": {
    "langsmith": ">=0.4.6"
  },
  "devDependencies": {
    "@opentelemetry/api-logs": "^0.213.0",
    "import-in-the-middle": "^3.0.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.213.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-logs": "^0.213.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@traceloop/instrumentation-langchain": "^0.22.6",
    "@traceloop/instrumentation-mcp": "^0.22.6",
    "@traceloop/node-server-sdk": "^0.22.8",
    "@vitest/coverage-v8": "^4.0.18",
    "vitest": "^4.0.18"
  }
}
