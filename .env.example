# Anthropic API Key (required)
ANTHROPIC_API_KEY=your-api-key-here

# Optional: Override default model
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional: Journal output directory
# JOURNAL_DIR=./journal

# Optional: Activate LLM auto-instrumentation (LangChain + MCP spans via Traceloop)
# Requires COMMIT_STORY_TRACELOOP=true in the run environment — not a .env file setting.
# Effect: adds LLM call detail spans (model, tokens, latency) to Datadog traces.
# Only applies when running with an OTel-instrumented binary (spiny-orb instrument branch).
# COMMIT_STORY_TRACELOOP=true
